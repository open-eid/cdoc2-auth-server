<?xml version="1.0" encoding="UTF-8" standalone="no"?>

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet author="auth" id="create_table__auth_process_session_nonce.0000" dbms="h2">
        <createSequence cacheSize="20"
                        cycle="false"
                        incrementBy="1"
                        ordered="false"
                        sequenceName="AUTH_PROCESS_SESSION_NONCE_PK_SEQUENCE"
                        startValue="1"/>
    </changeSet>
    <changeSet author="auth" id="create_table__auth_process_session_nonce.0000" dbms="postgresql">
        <createSequence cacheSize="20"
                        cycle="false"
                        incrementBy="1"
                        maxValue="9223372036854775807"
                        minValue="1"
                        sequenceName="AUTH_PROCESS_SESSION_NONCE_PK_SEQUENCE"
                        startValue="1"/>
    </changeSet>

    <changeSet author="auth" id="create_table__auth_process_session_nonce.0001">
        <createTable tableName="AUTH_PROCESS_SESSION_NONCE"
                     remarks="Server session nonce associated with an authentication process">

            <column name="ID" type="NUMBER(19, 0)">
                <constraints nullable="false" primaryKey="true"/>
            </column>

            <column name="AUTH_PROCESS_ID"
                    remarks="ID of the authentication process"
                    type="NUMBER(19, 0)">
                <constraints nullable="false"/>
            </column>

            <column name="URI_ID"
                    remarks="URI of server owning the session nonce"
                    type="NUMBER(19, 0)">
                <constraints nullable="false"/>
            </column>

            <column name="SESSION_NONCE"
                    remarks="Session nonce from server"
                    type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="AUTH_PROCESS_ID"
                                 baseTableName="AUTH_PROCESS_SESSION_NONCE"
                                 constraintName="FK_AUTH_PROCESS__AUTH_ID"
                                 deferrable="false"
                                 initiallyDeferred="false"
                                 onDelete="CASCADE"
                                 onUpdate="CASCADE"
                                 referencedColumnNames="ID"
                                 referencedTableName="AUTH_PROCESS"/>

        <addForeignKeyConstraint baseColumnNames="URI_ID"
                                 baseTableName="AUTH_PROCESS_SESSION_NONCE"
                                 constraintName="FK_SERVER_SESSION_NONCE__URI_ID"
                                 deferrable="false"
                                 initiallyDeferred="false"
                                 onDelete="CASCADE"
                                 onUpdate="CASCADE"
                                 referencedColumnNames="ID"
                                 referencedTableName="SERVER_SESSION_NONCE_URI"/>

        <addUniqueConstraint tableName="AUTH_PROCESS_SESSION_NONCE"
                             columnNames="AUTH_PROCESS_ID, URI_ID"
                             constraintName="C_UNIQ_AUTH_PROCESS_SESSION_NONCE_URI"/>

        <rollback>
            <dropUniqueConstraint tableName="AUTH_PROCESS_SESSION_NONCE"
                                  constraintName="C_UNIQ_AUTH_PROCESS_SESSION_NONCE_URI"/>

            <dropForeignKeyConstraint
                    baseTableName="AUTH_PROCESS_SESSION_NONCE"
                    constraintName="FK_AUTH_PROCESS__AUTH_ID"/>

            <dropTable tableName="AUTH_PROCESS_SESSION_NONCE"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
